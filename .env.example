# Copie para .env (que já está no .gitignore) e preencha os valores reais.
# Nunca commite o .env de verdade — ele carrega a chave SMTP da Brevo.

# Brevo SMTP — pegue a chave em https://app.brevo.com em
# Configurações > SMTP e API > aba SMTP > "Gerar uma nova chave SMTP"
# (é diferente da senha da sua conta Brevo)
MAIL_USERNAME=b44431001@smtp-brevo.com
MAIL_PASSWORD=
MAIL_FROM=noreply@femass.edu.br

# Supabase Storage (bucket para anexos) — painel Supabase > Storage:
# - STORAGE_ENDPOINT: https://<project-ref>.supabase.co/storage/v1/s3
# - STORAGE_REGION: a região do seu projeto Supabase (ex.: sa-east-1, us-east-1 —
#   veja em Project Settings > General > Region)
# - STORAGE_ACCESS_KEY_ID / STORAGE_SECRET_ACCESS_KEY: Storage > "S3 Connection" >
#   New access key (são credenciais diferentes da chave de API do Supabase)
# - STORAGE_BUCKET_NAME: nome do bucket criado em Storage (marque como "Public bucket")
# - STORAGE_PUBLIC_URL: https://<project-ref>.supabase.co/storage/v1/object/public/<bucket-name>
STORAGE_ENDPOINT=
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=
STORAGE_PUBLIC_URL=
